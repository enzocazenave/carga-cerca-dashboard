# Puerto del servidor (Railway lo define automáticamente)
PORT=3000

# Ruta del archivo SQLite.
# Local:
DATABASE_PATH=./data/cargacerca.sqlite
# Railway con Volume montado en /data:
# DATABASE_PATH=/data/cargacerca.sqlite

# Admin real del panel: se crea al arrancar (o se le actualiza la contraseña).
ADMIN_EMAIL=equipo@ejemplo.com
ADMIN_PASSWORD=cambiar-esta-clave

# Botones "Anfitrión demo" / "Admin demo" en /login (1 = prendidos).
# DEMO_LOGIN=1
